# Global variables
ENVIRONMENT=dev
JWT_SECRET=super-secure-random-key

# Server variables
SERVER_ADDRESS=0.0.0.0:8080
# Timeout in seconds
SERVER_TIMEOUT=4s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# DB variables
DB_NAME=postgres
DB_HOST=db
DB_PORT=5432
DB_USER=dbuser
DB_PASS=my_db_password
SEED_USERS=true
# DB healthcheck variables
# DB_INTERVAL=5s
# DB_TIMEOUT=5s
# DB_RETRIES=5

# MinIO / S3 variables
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_USE_SSL=false