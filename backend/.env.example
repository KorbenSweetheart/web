# Global variables
ENVIRONMENT=dev
JWT_SECRET=super-secure-random-key

# Server variables
SERVER_ADDRESS=localhost:8080
# Timeout in seconds
SERVER_TIMEOUT=4s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# DB variables
DB_NAME=postgres
DB_PORT=5432
DB_USER=dbuser
DB_PASS=my_db_password
